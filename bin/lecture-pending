#!/usr/bin/env bash
# Give notes to transcripts that arrived without them: notes written by another
# device (the phone app) into the vault with `notes_status: pending`, or lectures
# whose notes pass failed earlier. Runs from lecture-pending.timer and by hand.
#
#   lecture-pending            run the notes pass on every pending note
#   lecture-pending --list     show them only
set -uo pipefail
# shellcheck source=../lib/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

LIST=0
case "${1:-}" in --list) LIST=1 ;; -h|--help) sed -n '2,8p' "$0"; exit 0 ;; esac


roots=("$LECTURE_ROOT/transcripts")
[[ -n "$LECTURE_NOTES_ROOT" && -d "$LECTURE_NOTES_ROOT" ]] && roots+=("$LECTURE_NOTES_ROOT")
# Nothing while a recording is in progress: the GPU would put fan noise into it.
[[ "$LIST" == 1 ]] || ! lp_recording_running || { echo "recording in progress, try later"; exit 0; }
n=0; done_n=0
while IFS= read -r note; do
  grep -q '^notes_status: pending' "$note" || continue
  grep -q 'LECTURE-NOTES-START' "$note" || continue
  words="$(grep -m1 '^words:' "$note" | awk '{print $2}')"
  [[ "${words:-0}" -ge 120 ]] || continue
  n=$((n+1))
  if [[ "$LIST" == 1 ]]; then echo "$note"; continue; fi
  echo "▶ $note"
  if lecture-notes "$note"; then done_n=$((done_n+1)); fi
done < <(find "${roots[@]}" -path '*/lectures/*' -name '*.md' -not -path '*/.state/*' 2>/dev/null; find "$LECTURE_ROOT/transcripts" -maxdepth 2 -name '*.md' -not -type l 2>/dev/null)
[[ "$LIST" == 1 ]] && { echo "$n pending"; exit 0; }
[[ "$n" -gt 0 ]] && { lecture-index >/dev/null 2>&1 || true; echo "notes written for $done_n of $n pending note(s)"; }
exit 0
