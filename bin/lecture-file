#!/usr/bin/env bash
# File a transcribed session into its course folder in the notes vault:
#   $LECTURE_NOTES_ROOT/<CODE Title>/lectures/NN/  <- .md, .srt, .txt, .json, audio
# Labs go to labs/NN/ and recitations to recitations/NN/, by the kind token in the
# file name (lp_session in lib/common.sh). Symlinks stay behind in
# $LECTURE_ROOT/{transcripts,audio}/<CODE>/ so the index, status and note re-runs keep working.
#
#   lecture-file <note.md> [NN]
# NN comes from the argument, else from "lecture-N", "lab-N" or "recitation-N" in the
# file name, else the session goes to <kind folder>/<date>/ to be sorted by hand.
# A session whose names are already taken in that folder (a second unnumbered lab
# of the day, say) is filed as <name>-take<N>, never over the first one.
# With LECTURE_NOTES_ROOT unset this does nothing.
set -euo pipefail
# shellcheck source=../lib/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

NOTE="${1:-}"
[[ -f "$NOTE" ]] || { echo "usage: lecture-file <note.md> [NN]" >&2; exit 2; }
[[ -n "$LECTURE_NOTES_ROOT" ]] || exit 0
NOTE="$(realpath -s "$NOTE")"
[[ -L "$NOTE" ]] && { echo "  already filed: $(readlink "$NOTE")"; exit 0; }

COURSE="$(grep -m1 '^course:' "$NOTE" | awk '{print $2}')"
DATE="$(grep -m1 '^date:' "$NOTE" | awk '{print $2}')"
AUDIO="$(grep -m1 '^audio:' "$NOTE" | sed -E 's/^audio:[[:space:]]*"?//; s/"?[[:space:]]*$//')"
STEM="$(basename "$NOTE" .md)"
SRCDIR="$(dirname "$NOTE")"

CDIR="$(lp_vault_course_dir "$COURSE")"
[[ -n "$CDIR" ]] || { echo "  ! no single course folder for $COURSE in $LECTURE_NOTES_ROOT (\"$COURSE Title\" or \"title_${COURSE,,}\"); not filed" >&2; exit 1; }

IFS=$'\t' read -r KIND NN <<< "$(lp_session "$STEM")"
KDIR="$(lp_kind_dir "$KIND")"
NN="${2:-$NN}"
if [[ -n "$NN" ]]; then
  DEST="$CDIR/$KDIR/$(printf '%02d' "$((10#$NN))")"
else
  DEST="$CDIR/$KDIR/$DATE"
  echo "  ! no $KIND number in the name; filing under $KDIR/$DATE"
fi
mkdir -p "$DEST"

HAS_AUDIO=""; [[ -n "$AUDIO" && -f "$AUDIO" && ! -L "$AUDIO" ]] && HAS_AUDIO=1
ABASE="$(basename "$AUDIO")"; ASTEM="${ABASE%.*}"; AEXT="${ABASE##*.}"
# A take is free when none of the files this filing would write is there yet.
SUFFIX=""
dest_taken() {
  local sfx="${1#"$STEM"}" ext
  for ext in md srt txt json; do [[ -e "$DEST/$STEM$sfx.$ext" || -L "$DEST/$STEM$sfx.$ext" ]] && return 0; done
  [[ -n "$HAS_AUDIO" && ( -e "$DEST/$ASTEM$sfx.$AEXT" || -L "$DEST/$ASTEM$sfx.$AEXT" ) ]]
}
SUFFIX="$(lp_take_name "$STEM" dest_taken)"; SUFFIX="${SUFFIX#"$STEM"}"
[[ -z "$SUFFIX" ]] || echo "  ! $KDIR/${DEST##*/} already holds $STEM, filing this one as $STEM$SUFFIX"

move() {  # move $1 into $DEST as $2 and leave a symlink behind
  local src="$1" dst="$DEST/$2"
  [[ -e "$src" && ! -L "$src" ]] || return 0
  if mv -n "$src" "$dst" && [[ ! -e "$src" ]]; then ln -s "$dst" "$src"; else echo "  ! could not move $src" >&2; fi
}

for ext in srt txt json; do move "$SRCDIR/$STEM.$ext" "$STEM$SUFFIX.$ext"; done
if [[ -n "$HAS_AUDIO" ]]; then
  move "$AUDIO" "$ASTEM$SUFFIX.$AEXT"
  sed -i -E "s|^audio:.*|audio: \"$DEST/$ASTEM$SUFFIX.$AEXT\"|" "$NOTE"
fi
move "$NOTE" "$STEM$SUFFIX.md"
if [[ ! -L "$NOTE" ]]; then
  echo "  ✖ not filed: could not move $NOTE to $DEST/$STEM$SUFFIX.md" >&2; exit 1
fi

echo "  ✔ filed → $DEST/$STEM$SUFFIX.md"
