#!/usr/bin/env bash
# Record a lecture. Ctrl-C to stop.
#   lecture-record COURSE ["topic"]              live: transcribe as it happens, keep no audio (default)
#   lecture-record --keep-audio COURSE ["topic"] save a FLAC to the inbox, transcribe afterwards
#   lecture-record --live COURSE ["topic"]       force live mode
# The default comes from LECTURE_RECORD_MODE (live | record) in the config.
set -euo pipefail
# shellcheck source=../lib/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

MODE="$LECTURE_RECORD_MODE"
while [[ "${1:-}" == -* ]]; do
  case "$1" in
    --keep-audio|--record) MODE=record; shift ;;
    --live) MODE=live; shift ;;
    -h|--help) sed -n '2,6p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done
if [[ "$MODE" == live ]]; then
  exec lecture-live "$@"
fi

INBOX="$LECTURE_ROOT/inbox"
mkdir -p "$INBOX"

COURSE="${1:-misc}"
TOPIC="${2:-}"
COURSE="$(printf '%s' "$COURSE" | tr '[:lower:]' '[:upper:]')"
SLUG="$(printf '%s' "$TOPIC" | tr '[:upper:] ' '[:lower:]-' | sed -E 's/[^a-z0-9-]+//g; s/-+/-/g; s/^-|-$//g')"

NAME="${COURSE}_$(date +%F)${SLUG:+_$SLUG}"
OUT="$INBOX/${NAME}.flac"
n=2; while [[ -e "$OUT" ]]; do OUT="$INBOX/${NAME}-${n}.flac"; n=$((n+1)); done

command -v ffmpeg >/dev/null 2>&1 || { echo "✖ ffmpeg not found" >&2; exit 1; }

# Transcribing an earlier lecture spins the fans up and puts that noise into
# whatever you record next. Back-to-back lectures make that a real scenario, so
# hold the queue until the recording stops.
WATCHER_WAS_ACTIVE=0
if systemctl --user is-active --quiet lecture-watch.path 2>/dev/null; then
  WATCHER_WAS_ACTIVE=1
  systemctl --user stop lecture-watch.path 2>/dev/null || true
fi
resume_watcher() {
  [[ "$WATCHER_WAS_ACTIVE" == 1 ]] && systemctl --user start lecture-watch.path 2>/dev/null || true
}
trap resume_watcher EXIT INT TERM

echo "● recording → $(basename "$OUT")"
[[ -n "$LECTURE_MIC" ]] && echo "  source: $LECTURE_MIC"
echo "  press Ctrl-C to stop"
echo "  (the people in the room should know they are being recorded)"

# FLAC: lossless, about 5x smaller than wav, and Whisper reads it natively.
# 16 kHz mono is exactly what the model wants, there is no point recording more.
ffmpeg -nostdin -loglevel error -stats \
  -f pulse -i "${LECTURE_MIC:-default}" \
  -ar 16000 -ac 1 -c:a flac -compression_level 8 \
  "$OUT" || true

echo
if [[ -s "$OUT" ]]; then
  echo "✔ saved $(du -h "$OUT" | cut -f1) → $OUT"
  echo "  the watcher will transcribe it shortly (or: lecture-transcribe '$OUT')"
else
  rm -f "$OUT"; echo "✖ nothing recorded. Check your input with: pactl list sources short"
fi
